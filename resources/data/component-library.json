{
  "system": "Liquid Glass V3",
  "version": "1.1.0",
  "components": [
    {
      "key": "text_input",
      "label": "Text Input",
      "props": ["label", "placeholder", "required", "validation"],
      "styling": { "radius": "12pt", "border": "1pt" }
    },
    {
      "key": "ic_input",
      "label": "IC Number Input",
      "props": ["label", "required"],
      "validation": { "pattern": "^[0-9]{6}-[0-9]{2}-[0-9]{4}$" }
    },
    {
      "key": "phone_input",
      "label": "Phone Input",
      "props": ["label", "required"],
      "validation": { "pattern": "^01[0-9]-[0-9]{7,8}$" }
    },
    {
      "key": "amount_input",
      "label": "Currency Input",
      "props": ["label", "required", "currency"],
      "currency": "MYR"
    },
    {
      "key": "select",
      "label": "Dropdown Select",
      "props": ["label", "options", "required"]
    },
    {
      "key": "date_picker",
      "label": "Date Picker",
      "props": ["label", "min_date", "max_date", "required"]
    },
    {
      "key": "checkbox",
      "label": "Checkbox",
      "props": ["label", "checked_value", "required"]
    },
    {
      "key": "radio",
      "label": "Radio Group",
      "props": ["label", "options", "required"]
    },
    {
      "key": "textarea",
      "label": "Text Area",
      "props": ["label", "placeholder", "rows"]
    },
    {
      "key": "file_upload",
      "label": "File Upload",
      "props": ["label", "accept", "max_size"]
    },
    {
      "key": "repeater",
      "label": "Field Repeater",
      "props": ["label", "min_items", "max_items", "fields"]
    },
    {
      "key": "card",
      "label": "Container Card",
      "props": ["title", "content", "variant"]
    },
    {
      "key": "button",
      "label": "Action Button",
      "props": ["label", "variant", "action"]
    },
    {
      "key": "badge",
      "label": "Status Badge",
      "props": ["label", "color"]
    },
    {
      "key": "alert",
      "label": "System Alert",
      "props": ["type", "message", "icon"]
    },
    {
      "key": "modal",
      "label": "Overlay Modal",
      "props": ["title", "size", "content"]
    },
    {
      "key": "tabs",
      "label": "Navigation Tabs",
      "props": ["items", "active_key"]
    },
    {
      "key": "signature_pad",
      "label": "E-Signature Pad",
      "category": "ar_rahnu_core",
      "props": ["label", "required", "help_text"],
      "data_type": "base64",
      "description": "Touch-enabled signature canvas. Captures customer digital signature as base64 PNG. Used for PDPA consent, SAG acceptance, and redemption authorization."
    },
    {
      "key": "camera_capture",
      "label": "Camera Capture",
      "category": "ar_rahnu_core",
      "props": ["label", "required", "capture_count", "help_text"],
      "data_type": "file",
      "description": "Device camera access for capturing marhun (collateral) photos. Supports multi-angle capture (front and side). Images stored as file attachments."
    },
    {
      "key": "scanner_input",
      "label": "Hardware Scanner Input",
      "category": "ar_rahnu_core",
      "props": ["label", "required", "scan_type", "placeholder"],
      "data_type": "string",
      "description": "Input field optimized for USB/HID barcode scanners and IC card readers. Listens for rapid keystrokes (< 50ms between characters) to distinguish scanner input from manual typing. Use scan_type: 'ic_reader' for MyKad or 'barcode' for item tags."
    },
    {
      "key": "gold_repeater",
      "label": "Gold Items Repeater",
      "category": "ar_rahnu_core",
      "props": ["label", "min_items", "max_items"],
      "data_type": "collection",
      "description": "Specialized repeater for gold item entry. Each row captures: gold_type (916/999/750), weight_gross, weight_net, description, and market_value."
    },
    {
      "key": "nominee_repeater",
      "label": "Nominee Repeater",
      "category": "ar_rahnu_core",
      "props": ["label", "min_items", "max_items"],
      "data_type": "collection",
      "description": "Repeater for nominee registration. Each row captures: name, ic_number, relationship, and allocation_percentage."
    },
    {
      "key": "summary_panel",
      "label": "Summary Panel",
      "category": "display",
      "props": ["title", "data_source"],
      "data_type": "display",
      "description": "Read-only summary card displaying computed values from flow context. Used to show calculation results like Murabahah sale price, total ujrah, and redemption amount."
    },
    {
      "key": "timeline",
      "label": "Timeline",
      "category": "display",
      "props": ["data_source"],
      "data_type": "display",
      "description": "Vertical timeline showing facility lifecycle events: application, valuation, approval, disbursement, repayment, redemption/auction."
    }
  ],
  "tokens": {
    "spacing": [4, 8, 12, 16, 24, 32, 48, 64],
    "typography": {
      "display": { "size": "34pt", "weight": "bold" },
      "title1": { "size": "28pt", "weight": "bold" },
      "title2": { "size": "22pt", "weight": "bold" },
      "headline": { "size": "17pt", "weight": "semibold" },
      "body": { "size": "17pt", "weight": "regular" },
      "subhead": { "size": "15pt", "weight": "regular" },
      "footnote": { "size": "13pt", "weight": "regular" }
    },
    "colors": {
      "primary": "systemBlue",
      "danger": "systemRed",
      "success": "systemGreen",
      "warning": "systemOrange",
      "neutral": "systemGray"
    }
  }
}
